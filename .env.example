# Copy to .env.local to override.

# First-launch admin PIN (4–8 digits). Seeds the stored PIN the first time the
# app opens in a browser; after that change it under Admin → Settings.
# Defaults to 2580 when unset. TODO(prod-auth): real auth is a later ticket.
VITE_ADMIN_PIN=2580

# Parent testing only: treat the app as live before the 2026-09-28 go-live so
# kids can send Path A claims. Never bypasses Sunday or the 8 PM Denver cutoff.
# The same switch is available at runtime on Admin → Clock.
VITE_FORCE_LIVE=false
